    create or replace table `project-5fbc8bf7-2dd6-4f0a-a5f`.`hospital_gold`.`patient_360`
      
    
    

    
    OPTIONS()
    as (
      SELECT
    r.registration_id,
    r.patient_id,
    r.registration_date,
    r.city,
    COUNT(DISTINCT e.encounter_id) AS encounter_count,
    COUNT(DISTINCT a.admission_id) AS admission_count,
    COUNT(DISTINCT d.discharge_id) AS discharge_count,
    COUNT(DISTINCT b.bill_id) AS bill_count,
    COALESCE(SUM(b.total_amount), 0) AS total_billed
FROM `project-5fbc8bf7-2dd6-4f0a-a5f`.`hospital_silver`.`stg_registrations` AS r
LEFT JOIN `project-5fbc8bf7-2dd6-4f0a-a5f`.`hospital_silver`.`stg_encounters` AS e
    ON r.registration_id = e.registration_id
LEFT JOIN `project-5fbc8bf7-2dd6-4f0a-a5f`.`hospital_silver`.`stg_admissions` AS a
    ON r.registration_id = a.registration_id
LEFT JOIN `project-5fbc8bf7-2dd6-4f0a-a5f`.`hospital_silver`.`stg_discharges` AS d
    ON r.registration_id = d.registration_id
LEFT JOIN `project-5fbc8bf7-2dd6-4f0a-a5f`.`hospital_silver`.`stg_billing` AS b
    ON r.registration_id = b.registration_id
GROUP BY r.registration_id, r.patient_id, r.registration_date, r.city
    );
  
